<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'stylesheets' -%}
    {% render 'customcode-styles' %}
    {% render 'customcode-header-scripts' %}
    {% render 'customcode-meta-tags' %}
    {% render 'customcode-schema-tags' %}

    <meta name="google-site-verification" content="O9w9EZAAbBzwUEtGdIX5p0z1AN7OKSKpPbWUy6crhxE">

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>
  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P48PB3L"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe
    ></noscript>
    <!-- End Google Tag Manager (noscript) -->

    {% if canonical_url contains '/products/top-bottom-teeth' %}
      {% comment %}
        <div id="congrats-overlay" class="congrats-overlay">
          <p><span class="congrats-word">Congrats!</span> <span class="you-qualify-wrd">You Qualify!</span></p>
        </div>
      {% endcomment %}
      <div id="congrats-overlay-alt" class="congrats-overlay">
        <p>
          <span class="congrats-word">Congrats!</span>
          <span class="you-qualify-wrd"
            >You unlocked extra $20 off!<br>
            <span>Today Only!</span></span
          >
        </p>
      </div>
    {% endif %}
    {% section 'customcode-menu-drawer' %}
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}

      {% comment %} Color Choice Display {% endcomment %}
      {% if page.handle == 'your-color-choice' 
        or page.handle == "color-choice" 
        or page.metafields.custom.custom_page_display == 'Color Options'
      %}
        {% sections 'customcode-color-choice-group' %}
      {% endif %}      

      {% comment %} Customcode Groupings {% endcomment %}
      {% if template.name == 'index' %}
        {% sections 'customcode-hp-1-group' %}
        {% sections 'customcode-hp-2-group' %}
        {% comment %}
          {% sections 'customcode-home-alt-1-group' %}
          {% sections 'customcode-home-alt-2-group' %}
        {% endcomment %}
      {% endif %}

      {% comment %} Display LYS TEMPLATE {% endcomment %}
      {% if page.metafields.custom.custom_page_display == 'Love Your Smile Template'
        or template.suffix == 'love-your-smile-1'
        or template.suffix == 'blog-faq'
        or template.suffix == 'general-dynamic-button'
        or template.suffix == 'blog-faq-eating'
      %}
        {% comment %}
          Old LYS template
          {% sections 'customcode-home-1-group' %}
          {% sections 'customcode-home-2-group' %}
        {% endcomment %}
        {% sections 'customcode-home-alt-1-group' %}
        {% sections 'customcode-home-alt-2-group' %}
      {% endif %}

      {% if template.suffix == 'tamar-love-your-smile-1' %}
        {% sections 'customcode-home-tamar-1-group' %}
        {% sections 'customcode-home-tamar-group' %}
      {% endif %}

      {% if template.suffix == 'landing-pouch' %}
        {% sections 'customcode-landing-pouch-group' %}
      {% endif %}

      {% if page.metafields.custom.custom_page_display == 'Shop Page' %}
        {% sections 'customcode-shop-group' %}
      {% endif %}
      {% if page.metafields.custom.custom_page_display == 'VIP Shop Page' %}
        {% sections 'customcode-vip-shop-group' %}
      {% endif %}
      {% if product.handle == 'top-bottom-teeth'
        or page.metafields.custom.custom_page_display == 'Pop On Veneers with Impression Kit Template'
        or product.id == 8820560298122
      %}
        {% sections 'customcode-top-bottom-group' %}
      {% endif %}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% render 'rebuy-extensions' %}
    {% render 'rebuy-cart-template' %}
    {% render 'customcode-scripts' %}
  </body>
</html>
