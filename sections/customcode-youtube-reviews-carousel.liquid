{% comment %}
  YouTube Reviews Carousel section.

  Page 1 is rendered server-side here by reading pages[base_handle].content and
  extracting YouTube video ids. Pages 2+ are lazy-loaded client-side by
  assets/customcode-youtube-carousel.js. See snippet
  customcode-youtube-carousel-slider for markup/styles.
{% endcomment %}

{%- assign yt_base = section.settings.base_handle | default: 'video-reviews' -%}
{%- assign yt_quality = section.settings.thumbnail_quality | default: 'hqdefault' -%}
{%- if section.settings.use_feed_view -%}
  {%- assign yt_feed = 'true' -%}
{%- else -%}
  {%- assign yt_feed = 'false' -%}
{%- endif -%}

{%- comment -%} Extract page-1 video ids from the source page body. {%- endcomment -%}
{%- assign page1_ids = '' -%}
{%- assign src_page = pages[yt_base] -%}
{%- if src_page != blank and src_page.content != blank -%}
  {%- assign embed_parts = src_page.content | split: '/embed/' -%}
  {%- for part in embed_parts offset: 1 -%}
    {%- assign vid = part | slice: 0, 11 -%}
    {%- if vid != blank -%}
      {%- assign page1_ids = page1_ids | append: vid | append: ',' -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign page1_ids = page1_ids | split: ',' -%}

{%- comment -%} Resource hints for the YouTube thumbnail and embed hosts. {%- endcomment -%}
<link rel="preconnect" href="https://i.ytimg.com" crossorigin>
<link rel="preconnect" href="https://www.youtube.com" crossorigin>

{% render 'customcode-youtube-carousel-slider',
  video_ids: page1_ids,
  quality: yt_quality,
  base_handle: yt_base,
  feed_view: yt_feed,
  heading: section.settings.heading %}

<script src="{{ 'customcode-youtube-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "C YouTube Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Video Reviews"
    },
    {
      "type": "text",
      "id": "base_handle",
      "label": "Base page handle",
      "info": "First page handle. Pages 2+ are loaded by following each page's in-page \"More videos\" button link until a page has no such button.",
      "default": "video-reviews"
    },
    {
      "type": "select",
      "id": "thumbnail_quality",
      "label": "Thumbnail quality",
      "options": [
        { "value": "mqdefault", "label": "Medium (16:9, lighter)" },
        { "value": "hqdefault", "label": "High (cropped to 16:9)" },
        { "value": "sddefault", "label": "Standard" },
        { "value": "maxresdefault", "label": "Max (not always available)" }
      ],
      "default": "hqdefault"
    },
    {
      "type": "checkbox",
      "id": "use_feed_view",
      "label": "Fetch lightweight feed view",
      "info": "Requires the 'video-feed' template assigned to the review pages. Uncheck to fetch full pages.",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "C YouTube Reviews",
      "category": "Custom"
    }
  ]
}
{% endschema %}
