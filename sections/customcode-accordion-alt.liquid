{% style %}
  c-accordion-alt .content-wrapper {max-width: 1400px; margin: auto; padding: 15px 20px;}
  c-accordion-alt .inner-container {flex: 1; width: 100%;}
  c-accordion-alt .inner-container > h2 {text-align: center; color: #003659; flex: 1;}
  c-accordion-alt .inner-container .accordion-container {display: flex; flex-direction: column; gap: 20px; max-width: 1000px; margin: auto;}
  c-accordion-alt .inner-container .accordion-item {background-color: #d9d9d9; border-radius: 19px; padding: 20px; display: flex; flex-direction: column; gap: 20px;}
  c-accordion-alt .inner-container .accordion-item .question-container {display: flex; gap: 5px; justify-content: space-between; align-items: center}
  c-accordion-alt .inner-container .accordion-item .question-container p {flex: 1; margin: 0; font-weight: 600; color: #003659;}
  c-accordion-alt .inner-container .accordion-item .question-container .symbol-container {width: 10px; position: relative; aspect-ratio: 1; cursor: pointer;}
  c-accordion-alt .inner-container .accordion-item .question-container .symbol-container .c-hori {position: absolute; width: 100%; height: 3px; background: #003659; top: 50%; transform: translate(0, -50%);}
  c-accordion-alt .inner-container .accordion-item .question-container .symbol-container .c-verti {position: absolute; height: 100%; width: 3px; background: #003659; left: 50%; transform: translate(-50%, 0);}
  c-accordion-alt .inner-container .accordion-item .answer-container {display: none;}
  c-accordion-alt .inner-container .accordion-item .answer-container * {color: #003659; margin; 0;}
  c-accordion-alt .inner-container .accordion-item[active] .question-container .symbol-container .c-verti {display: none}
  c-accordion-alt .inner-container .accordion-item[active] .answer-container {display: block;}
  c-accordion-alt .inner-container a.c-button {margin: 20px auto 0 auto;}  
  c-accordion-alt .content-wrapper {display: flex; gap: 20px; align-items: center;}
  c-accordion-alt .image-container {flex: 1; width: 100%;}
  c-accordion-alt .image-container img {width: 100%; height: auto; display: block; border-radius: 10px; /* Optional */}
  c-accordion-alt[data-section-id="{{ section.id }}"] .layout-mobile { flex-direction: {{ section.settings.mobile_layout }}; }

  @media screen and (min-width: 769px) {
    c-accordion-alt[data-section-id="{{ section.id }}"] .layout-desktop {flex-direction: {{ section.settings.desktop_layout }}; }
    c-accordion-alt .content-wrapper {padding: 30px 40px;}
  }
{% endstyle %}

<c-accordion-alt data-section-id="{{ section.id }}">
  <div class="content-wrapper layout-mobile layout-desktop">
    {% if section.settings.image != blank %}
      <div class="image-container">
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
      </div>
    {% endif %}    
    <div class="inner-container">
      <h2>{{ section.settings.header }}</h2>
      <div class="accordion-container">
        {% for block in section.blocks %}
          <div class="accordion-item" data-index="{{ forloop.index0 }}">
            <div class="question-container">
              <p>{{ block.settings.question }}</p>
              <div class="symbol-container">
                <div class="c-hori"></div>
                <div class="c-verti"></div>
              </div>
            </div>
            <div class="answer-container">
              {{ block.settings.answer }}
              {% if block.settings.liquid != null %}
                {{ block.settings.liquid }}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.link != null %}
        <a href="{{ section.settings.link }}" class="c-button">
          {{ section.settings.name }}
        </a>
      {% endif %}
    </div>
  </div>
</c-accordion-alt>

{% schema %}
{
  "name": "C Accordion Alt",
  "settings": [
    {
      "type": "text",
      "id": "header",
      "label": "Header"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Button Name"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Image Position",
      "options": [
        { "value": "column", "label": "Top" },
        { "value": "column-reverse", "label": "Bottom" }
      ],
      "default": "column"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop Image Position",
      "options": [
        { "value": "row", "label": "Left" },
        { "value": "row-reverse", "label": "Right" }
      ],
      "default": "row-reverse"
    }    
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        },
        {
          "type": "liquid",
          "id": "liquid",
          "label": "liquid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "C Accordion Alt"
    }
  ]
}
{% endschema %}
