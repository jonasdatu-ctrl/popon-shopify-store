{% style %}
  {% for block in section.blocks %}
    {% if block.type == 'callout' %}
      c-featured-product[data-section="{{ section.id }}"] .pdp-callout .highlight {
        color: {{ block.settings.highlight_color }};
      }
    {% endif %}
  {% endfor %}
{% endstyle %}

{% if product %}
  {% assign c_product = product %}
{% else %}
  {% assign c_product = section.settings.product_override %}
{% endif %}

{% if c_product.tags contains section.settings.additional_product_tag %}
  {% assign freebie = true %}
{% else %}
  {% assign freebie = false %}
{% endif %}

{% assign freebie_product = section.settings.partially_additional_product | split: '|' %}

<c-featured-product
  data-section="{{ section.id }}"
  data-partially="{{ section.settings.enable_partially }}"
  data-partially-product-id="{{ freebie_product.first }}"
  data-partially-variant-id="{{ freebie_product.last }}"
  data-partially-freebie="{{ freebie }}"
  data-partially-freebie-price="{{ section.settings.freebie_price }}"
  data-partially-plan-fee="{{ section.settings.plan_fee }}"
  data-product-id="{{ product.id }}"
>
  {% if section.settings.enable_partially %}
    <script id="partially-variant-map" type="application/json">
      {
        {% for variant in product.variants %}
          "{{ variant.id }}": {
            {% comment %} "title": "{{ variant.option1 }} - Pop On Veneers - {{ variant.option2 }} / {{ variant.option3 }}", {% endcomment %}
            "title": "{{ product.title }} - {{ variant.title }}",
            "offer_id": "{% if variant.option1 contains 'Bi Weekly' %}f6dfea8b-51a4-49c8-a6ce-8405656d7e77{% elsif variant.option1 contains 'Monthly' %}0e028b92-3444-49b1-b6d4-021eb59a5c4c{% else %}59d7e98a-5749-46d7-b1f4-814739ae5086{% endif %}",
            "sku": "{{ variant.sku }}",
            "price": {{ variant.price | divided_by: 100 }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      }
    </script>
  {% endif %}
  <div class="inner-container">
    <div class="media-container">
      {% render 'customcode-media-gallery',
        product: c_product,
        mobile_count: section.settings.mobile_count,
        desktop_count: section.settings.desktop_count
      %}
    </div>
    <div class="product-info-container" id="product-info-container">
      {% for block in section.blocks %}
        {% style %}
          .product-info-row:not(.block-accordion)[data-row-index="{{ forloop.index0 }}"] {
            margin: 0 0 {{block.settings.m_margin_bottom}}px 0;
          }
          @media screen and (min-width: 769px) {
            .product-info-row:not(.block-accordion)[data-row-index="{{ forloop.index0 }}"] {
              margin: 0 0 {{block.settings.d_margin_bottom}}px 0;
            }
          }
        {% endstyle %}
        <div class="product-info-row block-{{ block.type }}" data-row-index="{{ forloop.index0 }}">
          {% case block.type %}
            {%- when '@app' -%}
              {% render block %}

            {% when 'html' %}
              <div class="html-container">
                {{ block.settings.html }}
              </div>

            {% when 'title' %}
              <div class="pdp-title">
                {% if block.settings.title_override != blank %}
                  <div>
                    {{ block.settings.title_override }}
                  </div>
                {% else %}
                  <h1>{{ block.settings.title_override | default: c_product.title }}</h1>
                {% endif %}
                {% if block.settings.show_reviews %}
                  {% render 'customcode-loox-reviews', product: c_product %}
                {% elsif block.settings.custom_review != blank %}
                  <a href="#looxReviews" class="c-review">
                    {% for i in (1..5) %}
                      {% render 'customcode-icons', icon: 'loox-star' %}
                    {% endfor %}
                    {{ block.settings.custom_review }}
                  </a>
                {% endif %}
              </div>

            {% when 'blurb_text' %}
              <div class="blurb_text">
                <{{ block.settings.tag }} style="color: {{ block.settings.color }};">
                  {{ block.settings.text }}
                </{{ block.settings.tag }}>
              </div>

            {% when 'callout' %}
              {% if block.settings.highlight != blank %}
                {% capture highlight_text %}<span class="highlight">{{ block.settings.highlight }}</span>{% endcapture %}
                {% assign new_text = block.settings.text | replace: block.settings.highlight, highlight_text %}
              {% else %}
                {% assign new_text = block.settings.text %}
              {% endif %}
              <c-callout class="pdp-callout">
                <h5>
                  {{ new_text }}
                  {% if block.settings.tooltip != empty %}
                    <img
                      class="tooltip-icon"
                      src="https://cdn.shopify.com/s/files/1/0382/1761/3450/files/0bc57d4b-2f34-4cd5-afda-fc8378fa7a72.png?v=1756392294"
                      data-tippy-content="{{ block.settings.tooltip | escape }}"
                      data-tooltip-bg="#FFF"
                    >
                  {% endif %}
                </h5>
              </c-callout>

            {% when 'variant_selector' %}
              {% render 'customcode-general-variant-selector', product: c_product, block: block %}

            {% when 'product_upsells' %}
              {% render 'customcode-product-upsells', product: c_product, block: block %}

            {% when 'buy_button' %}
              {% render 'customcode-buy-button', product: c_product, block: block %}

            {% when 'description' %}
              <div class="product-description">
                {{ product.description }}
              </div>

            {% when 'accordion' %}
              {% render 'customcode-accordion', block: block %}

            {% when 'freebies' %}
              {% render 'customcode-freebies',
                title: block.settings.title,
                img_one: block.settings.image_one,
                txt_one: block.settings.text_one,
                img_two: block.settings.image_two,
                txt_two: block.settings.text_two,
                img_three: block.settings.image_three,
                txt_three: block.settings.text_three,
                img_four: block.settings.image_four,
                txt_four: block.settings.text_four,
                button_text: block.settings.button_text
              %}

            {% when 'scarcity' %}
              {% render 'customcode-scarcity.liquid', product: c_product, block: block %}

            {% when 'property_input' %}
              {% render 'customcode-property-input', block: block %}

            {% when 'gift_card_recipient' %}
              {% render 'customcode-gift-card-recipient', block: block %}

            {% when 'selling_plan' %}
              {% render 'customcode-selling-plan', block: block %}

            {% when 'text_generator' %}
              {% style %}
                .text-generator[data-block-id="{{ block.id }}"] {
                  {% if block.settings.m_display %}
                    display: block;
                  {% else %}
                    display: none;
                  {% endif %}
                }
                .text-generator[data-block-id="{{ block.id }}"] * {
                  color: {{ block.settings.font_color }};
                  text-align: {{ block.settings.font_alignment }};
                  font-size: {{ block.settings.m_font_size }}px;
                }
                @media screen and (min-width: 769px) {
                  .text-generator[data-block-id="{{ block.id }}"] {
                    {% if block.settings.d_display %}
                      display: block;
                    {% else %}
                      display: none;
                    {% endif %}
                  }
                  .text-generator[data-block-id="{{ block.id }}"] * {
                    font-size: {{ block.settings.d_font_size }}px;
                  }
                }
              {% endstyle %}
              <div class="text-generator" data-block-id="{{ block.id }}">
                {{ block.settings.text }}
              </div>
            {% when 'buy_box_v2' %}
              {% render 'customcode-buy-box-v2', product: c_product, block: block, section: section, sub_features: block.settings.subscription_features %}

            {% when 'tags' %}
              {% assign tags = block.settings.tag | split: "|" %}
              <div class="cfp-tag-container" data-row-index="{{ forloop.index0 }}">
                {% for tag in tags %}
                  <div class="cfp-tag-item">
                    {{ tag }}
                  </div>
                {% endfor %}
              </div>

            {% when 'product_scroller' %}
              {% render 'customcode-product-scroller', block: block %}

            {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>
</c-featured-product>

