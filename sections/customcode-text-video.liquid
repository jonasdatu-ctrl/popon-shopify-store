<c-text-video>
  <div class="inner-container">
    <div class="left-container">
      <div class="top-content">
        {{ section.settings.top_content }}
      </div>
      <div class="video-content">
        {% if section.settings.video %}
          {{
            section.settings.video
            | video_tag:
              autoplay: section.settings.autoplay,
              loop: section.settings.loop,
              muted: section.settings.muted,
              controls: section.settings.controls
          }}
        {% elsif section.settings.video_url %}

        {% endif %}
      </div>
      <div class="bottom-content">
        {{ section.settings.bottom_content }}
      </div>
    </div>
    <div class="right-container">
      <div class="text-container">
        <h4 class="blurb">{{ section.settings.blurb }}</h4>
        <div class="header-text">
          {{ section.settings.header }}
        </div>
        <div class="featured-flex-container">
          {% assign feature_array = section.settings.features_grid | split: '|' %}
          {% assign feature_array_link = section.settings.features_grid_link | split: '|' %}
          {% for item in feature_array %}
            <a href="{{ feature_array_link[forloop.index0] }}" class="feature-item">
              {% render 'customcode-icons', icon: 'circled-check' %}
              {{ item }}
            </a>
          {% endfor %}
        </div>
        {% if section.settings.image_url != blank %}
          <div class="info-item block-image-list">
            {% assign url_list = section.settings.image_url | split: '|' %}
            {% capture img_width %}
            width: calc((100% - (10px * ({{ url_list.size }} - 1))) / {{ url_list.size }});
          {% endcapture %}
            {% for url in url_list limit: 6 %}
              <img src="{{ url }}" width="300px" height="150px;" style="{{ img_width }}">
            {% endfor %}
          </div>
        {% endif %}
        {% if section.settings.content != blank %}
          <div class="info-item block-info-content-grid">
            {% assign content_array = section.settings.content | split: '<p>-</p>' %}
            {% for content in content_array %}
              <div class="grid-item">
                {{ content }}
              </div>
            {% endfor %}
          </div>
        {% endif %}
        {% if section.settings.button_link != null %}
          <a href="{{ section.settings.button_link }}" class="c-button">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</c-text-video>

{% schema %}
{
  "name": "C Text Video",
  "settings": [
    {
      "type": "header",
      "content": "Left Section Settings"
    },
    {
      "type": "richtext",
      "id": "top_content",
      "label": "Top Content"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Muted",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "Controls",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "richtext",
      "id": "bottom_content",
      "label": "Bottom Content"
    },
    {
      "type": "header",
      "content": "Right Section Settings"
    },
    {
      "type": "text",
      "id": "blurb",
      "label": "Blurb"
    },
    {
      "type": "richtext",
      "id": "header",
      "label": "Header"
    },
    {
      "type": "text",
      "id": "features_grid",
      "label": "Features Grid",
      "info": "Separated by |"
    },
    {
      "type": "text",
      "id": "features_grid_link",
      "label": "Features Grid Link",
      "info": "Separated by |"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image Url",
      "info": "Enter Image URLs separated by '|'"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content Grid",
      "info": "separated by <p>-</p>"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    }
  ],
  "presets": [
    {
      "name": "C Text Video",
      "category": "Custom"
    }
  ]
}
{% endschema %}
