

<div
  id="IconTextGrid-{{ section.id }}"
  class="icon-text-grid spacing-style"
  style="
    --icon-text-grid-bg: {{ section.settings.background_color }};
    --icon-text-grid-heading-color: {{ section.settings.heading_color }};
    {% render 'spacing-style', settings: section.settings %}
  "
>
  {% if section.settings.heading != blank %}
    <div class="icon-text-grid__heading">{{ section.settings.heading }}</div>
  {% endif %}

  <div class="icon-text-grid__grid">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .icon-text-grid {
    background-color: var(--icon-text-grid-bg);
    max-width: 1300px;
    margin: auto;
  }

  .icon-text-grid__heading {
    margin: 0 0 1.5rem;
    color: var(--icon-text-grid-heading-color);
    text-align: center;
  }

  .icon-text-grid__heading :last-child {
    margin-block-end: 0;
  }

  .icon-text-grid__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
  }

  @media screen and (min-width: 750px) {
    .icon-text-grid__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Icon text grid",
  "tag": "section",
  "class": "icon-text-grid-wrapper section-wrapper",
  "max_blocks": 4,
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h2>Why a custom-fit guard makes all the difference.</h2>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading text",
      "default": "#0B2447"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "icon-text-card"
    }
  ],
  "presets": [
    {
      "name": "Icon text grid",
      "category": "Custom",
      "blocks": [
        {
          "type": "icon-text-card",
          "settings": {
            "heading": "Protect your teeth",
            "text": "Helps reduce wear from grinding and clenching."
          }
        },
        {
          "type": "icon-text-card",
          "settings": {
            "heading": "Custom, not generic",
            "text": "Made from your exact smile for a comfortable fit."
          }
        },
        {
          "type": "icon-text-card",
          "settings": {
            "heading": "Built to last",
            "text": "Durable outside. Softer inside. Made for nightly wear."
          }
        },
        {
          "type": "icon-text-card",
          "settings": {
            "heading": "We keep it on file",
            "text": "Reorder anytime. No new impression needed."
          }
        }
      ]
    }
  ]
}
{% endschema %}
