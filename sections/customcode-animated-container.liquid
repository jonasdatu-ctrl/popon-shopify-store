<script>
  function initWipAnimation() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(initWipAnimation, 100);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector('.wip-section');
    if (!section) return;

    // Show section now that script is running
    section.classList.add('is-ready');

    ScrollTrigger.getAll().forEach((st) => st.kill());
    gsap.set('.js-animation-item', { clearProps: 'all' });

    const mm = gsap.matchMedia();

    mm.add(
      {
        isMobile: '(max-width: 959px)',
        isDesktop: '(min-width: 960px)',
      },
      (context) => {
        const { isMobile } = context.conditions;
        const movement = window.innerWidth * 1.1;

        const firstImage = section.querySelector('.wip-first-image');
        const secondImage = section.querySelector('.wip-second-image');
        const thirdImage = section.querySelector('.wip-inner-image');
        const textBlock = section.querySelector('.wip-text-block');

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            start: 'top top',
            end: () => `+=${window.innerHeight * 0.8}`,
            scrub: 1,
            pin: true,
            invalidateOnRefresh: true,
            anticipatePin: 1,
            refreshPriority: 1, // FIX: Ensures this calc happens before other triggers
          },
        });

        tl.to(firstImage, { x: -movement, rotation: -120, scale: 0.7, ease: 'none' }, 0).to(
          secondImage,
          { x: movement, rotation: 120, scale: 0.7, ease: 'none' },
          0
        );

        if (isMobile) {
          tl.to(
            thirdImage,
            {
              keyframes: [
                { y: -20, scale: 0.8, rotation: 45, duration: 0.3 },
                { y: 0, scale: 1, rotation: 0, duration: 0.4 },
              ],
              ease: 'none',
            },
            0
          );
          tl.fromTo(textBlock, { scale: 0.9, opacity: 0 }, { y: '120%', scale: 1.1, opacity: 1, ease: 'none' }, 0.1);
        } else {
          tl.to(
            thirdImage,
            {
              keyframes: [
                { x: 100, y: 20, scale: 0.6, rotation: 20, duration: 0.25 },
                { x: 0, y: 0, scale: 1, rotation: 0, duration: 0.35 },
              ],
              ease: 'none',
            },
            0
          );
          tl.fromTo(
            textBlock,
            { y: '-50%', scale: 0.9, opacity: 0 },
            { y: '-50%', scale: 1.2, opacity: 1, ease: 'none' },
            0.1
          );
        }
      }
    );

    // FIX: Force a heavy refresh to lock in pins
    ScrollTrigger.refresh();
  }

  // Handle immediate execution
  if (document.readyState === 'complete') {
    initWipAnimation();
  } else {
    window.addEventListener('load', initWipAnimation);
  }

  // Shopify compatibility
  document.addEventListener('shopify:section:load', initWipAnimation);

  // Resize handler
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      ScrollTrigger.refresh();
    }, 250);
  });
</script>

