<style>
  /* FIX: Ensure a minimum height so the page doesn't collapse during GSAP init */
  .wip-section-wrapper {min-height: 100vh; background-color: white;}
  c-animated-container.wip-section {min-height: 700px; position: relative; overflow: hidden; max-width: 1400px; margin: auto; padding: 80px 0; display: block; background-color: white; visibility: hidden; /* Hide until GSAP is ready to prevent layout shift */}
  c-animated-container.is-ready { visibility: visible; }
  c-animated-container .wip-header {margin-bottom: 40px;}
  c-animated-container .wip-header h2 {font-weight: 400; text-align: center; color: #003659; margin: 0 0 15px 0;}
  c-animated-container .wip-header p {text-align: center; color: #003659; margin: 0 0 15px 0; text-wrap: balance;}
  c-animated-container .wip-main {position: relative; height: 100%;}
  c-animated-container .wip-first-image, c-animated-container .wip-second-image {top:0%; width:300px; height:300px; position:absolute; transform:translate(-50%,0); left: 50%;}
  c-animated-container .wip-first-image {z-index:4}
  c-animated-container .wip-second-image {z-index:2}
  c-animated-container .wip-inner-image {width:176px; height:auto; margin:35px 0; position:absolute; z-index:2; left: 50%; top: 0%; transform: translate(-50%,0) scale(0.45);}
  c-animated-container .wip-text-block {max-width:270px; width:100%; z-index:2; transform:none; margin:24px auto 0; position:absolute; display:grid; grid-template-columns:1fr; top:0%; left: 50%; transform: translate(-50%, 0%);}
  c-animated-container .wip-text-item * {position: relative; font-size:18px; line-height:34px; text-align: center; color: #003659; padding-left: 30px; text-wrap-style: balance; margin: 0 0 10px 0;}
  c-animated-container .wip-text-item *:before {content: ""; width: 1.3vw; height: 1.3vw; max-width: 25px; max-height: 25px; display: block; position: absolute; top: 33%; left: 0; transform: translateY(-50%); background-color: #003659;}
  c-animated-container .wip-text-item svg path {fill: #003659;}

  @media screen and (min-width: 960px) {
    c-animated-container .wip-section {min-height:100vh;}
    c-animated-container .wip-first-image, c-animated-container .wip-second-image, c-animated-container .wip-inner-image, c-animated-container .wip-text-block {width:471px; height:471px; top:0%; left:50%;}
    c-animated-container .wip-inner-image {width:400px; height:auto; z-index:3; transform:translate(-50%,0%) scale(.45); display: block;}
    c-animated-container .wip-text-block {top:50%; width:90%; max-width:980px; display:grid; grid-template-columns:1fr 1fr; row-gap:40px; column-gap:140px; height:auto; transform: translate(-50%, -50%); position: absolute;}
    c-animated-container .wip-text-item {position:relative; align-self:flex-end}
    c-animated-container .wip-text-item * {position:relative; font-size:clamp(24px,2.4vw,24px); font-weight:700; line-height:100%; margin:0; justify-self:start; text-align: left;}
    c-animated-container .wip-text-item:nth-child(2n) * { justify-self:end; text-align:end;}
    c-animated-container .wip-text-item:nth-child(2n) svg {transform: rotate(180deg); padding: 0;}
  }
</style>

