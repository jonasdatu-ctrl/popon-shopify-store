{% style %}
  .c-video-text-section {display: flex; flex-direction: column; gap: 20px; align-items: center; padding: 40px 20px; max-width: 1400px; margin: auto;}
  .c-video-container, .c-text-container {width: 100%;}
  .c-video-container video {width: 100%; height: auto; display: block;}
  .c-video-container, .c-text-container * {color: #003659; text-align: center;}
  @media (min-width: 768px) {
    .c-video-text-section {flex-direction: row; gap: 0;}
    .c-video-container, .c-text-container {flex: 0 0 50%; padding: 0 40px;}    
  }
{% endstyle %}

<section class="c-video-text-section">
  <div class="c-video-container">

    {% if section.settings.video_file != blank %}
      {{ section.settings.video_file | video_tag: controls: true, playsinline: true }}

    {% elsif section.settings.video_url != blank %}
      <video controls playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
        Your browser does not support the video tag.
      </video>

    {% else %}
      <div style="background: #eee; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center;">
        <p>No video selected</p>
      </div>
    {% endif %}

  </div>

  <div class="c-text-container">
    {% if section.settings.rich_text != blank %}
      <div class="rte">
        {{ section.settings.rich_text }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "C Video with Text",
  "settings": [
    {
      "type": "video",
      "id": "video_file",
      "label": "Video (Native Upload)"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (External MP4 Link)",
      "info": "Used if no native video is uploaded."
    },
    {
      "type": "richtext",
      "id": "rich_text",
      "label": "Text Content",
      "default": "<h2>Heading</h2><p>Add your descriptive text here.</p>"
    }
  ],
  "presets": [
    {
      "name": "C Video with Text"
    }
  ]
}
{% endschema %}