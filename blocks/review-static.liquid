

<div
  class="review-static-block review-static-block--align-{{ block.settings.text_alignment }}"
  style="
    --review-static-star-color: {{ block.settings.star_color }};
    --review-static-text-color: {{ block.settings.text_color }};
  "
  {{ block.shopify_attributes }}
>
  <div class="review-static-block__stars" aria-hidden="true">
    {% for i in (1..5) %}
      <svg class="review-static-block__star" viewBox="0 0 32 32" role="presentation">
        <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
      </svg>
    {% endfor %}
  </div>

  {% if block.settings.text != blank %}
    <p class="review-static-block__text">{{ block.settings.text }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .review-static-block {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6em;
    width: 100%;
  }

  .review-static-block--align-left {
    justify-content: flex-start;
  }

  .review-static-block--align-center {
    justify-content: center;
  }

  .review-static-block--align-right {
    justify-content: flex-end;
  }

  .review-static-block__stars {
    display: flex;
    align-items: center;
    gap: 0.15em;
  }

  .review-static-block__star {
    width: 1em;
    height: 1em;
    fill: var(--review-static-star-color);
  }

  .review-static-block__text {
    margin: 0;
    color: var(--review-static-text-color);
    font-size: 0.9em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Review with text",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Trusted by 20,000+ Pop On customers"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#FFB800"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Review with text",
      "category": "Custom"
    }
  ]
}
{% endschema %}
