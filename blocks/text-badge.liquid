

<div
  class="text-badge-block text-badge-block--align-{{ block.settings.text_alignment }}"
  style="
    --text-badge-badge-bg: {{ block.settings.badge_bg_color }};
    --text-badge-badge-color: {{ block.settings.badge_text_color }};
    --text-badge-label-color: {{ block.settings.label_color }};
    --text-badge-heading-color: {{ block.settings.heading_color }};
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.badge_text != blank or block.settings.eyebrow_text != blank %}
    <div class="text-badge-block__eyebrow">
      {% if block.settings.badge_text != blank %}
        <span class="text-badge-block__badge">{{ block.settings.badge_text }}</span>
      {% endif %}
      {% if block.settings.eyebrow_text != blank %}
        <span class="text-badge-block__label">{{ block.settings.eyebrow_text }}</span>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.heading != blank %}
    <div class="text-badge-block__heading">{{ block.settings.heading }}</div>
  {% endif %}
</div>

{% stylesheet %}
  .text-badge-block {
    display: flex;
    flex-direction: column;
  }

  .text-badge-block--align-left {
    align-items: flex-start;
    text-align: left;
  }

  .text-badge-block--align-center {
    align-items: center;
    text-align: center;
  }

  .text-badge-block--align-right {
    align-items: flex-end;
    text-align: right;
  }

  .text-badge-block__eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6em;
    margin-block-end: 0.6em;
  }

  .text-badge-block--align-center .text-badge-block__eyebrow,
  .text-badge-block--align-right .text-badge-block__eyebrow {
    justify-content: inherit;
  }

  .text-badge-block__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2em 0.6em;
    background-color: var(--text-badge-badge-bg);
    color: var(--text-badge-badge-color);
    font-size: 0.75em;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .text-badge-block__label {
    color: var(--text-badge-label-color);
    font-size: 0.85em;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .text-badge-block__heading {
    margin: 0;
    color: var(--text-badge-heading-color);
  }

  .text-badge-block__heading :last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Text with badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "New"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Label text",
      "default": "Made for Pop On customers"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h2>Your smile by day. Protected at night.</h2>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background",
      "default": "#2F6FED"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Text with badge",
      "category": "Custom"
    }
  ]
}
{% endschema %}
