

<div
  class="testimonial-card-block"
  style="
    --testimonial-card-star-color: {{ block.settings.star_color }};
    --testimonial-card-star-empty-color: {{ block.settings.star_empty_color }};
    --testimonial-card-quote-color: {{ block.settings.quote_color }};
    --testimonial-card-name-color: {{ block.settings.name_color }};
    --testimonial-card-divider-color: {{ block.settings.divider_color }};
  "
  {{ block.shopify_attributes }}
>
  <div class="testimonial-card-block__stars" aria-hidden="true">
    {% for i in (1..5) %}
      <svg
        class="testimonial-card-block__star{% if i <= block.settings.rating %} testimonial-card-block__star--filled{% endif %}"
        viewBox="0 0 32 32"
        role="presentation"
      >
        <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
      </svg>
    {% endfor %}
  </div>

  {% if block.settings.quote != blank %}
    <p class="testimonial-card-block__quote">{{ block.settings.quote }}</p>
  {% endif %}

  <div class="testimonial-card-block__divider"></div>

  <div class="testimonial-card-block__author">
    {% if block.settings.avatar != blank %}
      <span class="testimonial-card-block__avatar">
        {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', widths: '40, 60, 80, 120' }}
      </span>
    {% endif %}

    {% if block.settings.name != blank %}
      <span class="testimonial-card-block__name">— {{ block.settings.name }}</span>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .testimonial-card-block {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
    height: 100%;
  }

  .testimonial-card-block__stars {
    display: flex;
    align-items: center;
    gap: 0.15em;
  }

  .testimonial-card-block__star {
    width: 1.1em;
    height: 1.1em;
    fill: var(--testimonial-card-star-empty-color);
  }

  .testimonial-card-block__star--filled {
    fill: var(--testimonial-card-star-color);
  }

  .testimonial-card-block__quote {
    margin: 0;
    color: var(--testimonial-card-quote-color);
  }

  .testimonial-card-block__quote::before {
    content: '\201C';
  }

  .testimonial-card-block__quote::after {
    content: '\201D';
  }

  .testimonial-card-block__divider {
    margin-block-start: auto;
    border-block-start: 1px solid var(--testimonial-card-divider-color);
  }

  .testimonial-card-block__author {
    display: flex;
    align-items: center;
    gap: 0.75em;
  }

  .testimonial-card-block__avatar {
    display: flex;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
  }

  .testimonial-card-block__avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial-card-block__name {
    color: var(--testimonial-card-name-color);
    font-size: 0.9em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonial card",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "Fits perfectly and feels so comfortable. I forget I'm even wearing it."
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Sarah J."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star",
      "default": "#FFB800"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Star (empty)",
      "default": "#E5E5E5"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote text",
      "default": "#0B2447"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name text",
      "default": "#4A4A4A"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#E5E5E5"
    }
  ],
  "presets": [
    {
      "name": "Testimonial card",
      "category": "Custom"
    }
  ]
}
{% endschema %}
