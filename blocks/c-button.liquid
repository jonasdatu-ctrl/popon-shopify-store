

<a
  {% if block.settings.link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ block.settings.link }}"
  {% endif %}
  class="c-button-block size-style"
  style="
    {% render 'size-style', settings: block.settings %}
    --c-button-bg: {{ block.settings.background_color }};
    --c-button-color: {{ block.settings.text_color }};
  "
  {% if block.settings.open_in_new_tab %}
    target="_blank" rel="noopener noreferrer"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {{ block.settings.label }}
</a>

{% stylesheet %}
  .c-button-block {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--c-button-bg);
    color: var(--c-button-color);
    text-decoration: none;
    text-align: center;
    border-radius: var(--style-border-radius-buttons, 4px);
    padding-block: 0.9em;
    padding-inline: 1.75em;
    font-weight: 600;
  }

  .c-button-block:hover {
    opacity: 0.9;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "C Button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Get My Pop On Night Guard"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#2F6FED"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width (desktop)",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit content"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width (mobile)",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit content"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "C Button",
      "category": "Custom",
      "settings": {
        "link": "shopify://collections/all"
      }
    }
  ]
}
{% endschema %}
