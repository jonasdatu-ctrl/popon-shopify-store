

<div
  class="icon-text-block icon-text-block--align-{{ block.settings.text_alignment }}"
  style="--icon-text-color: {{ block.settings.text_color }};"
  {{ block.shopify_attributes }}
>
  {% if block.settings.icon != blank %}
    <span class="icon-text-block__icon">
      {{ block.settings.icon | image_url: width: 100 | image_tag: loading: 'lazy', widths: '25, 50, 75, 100' }}
    </span>
  {% endif %}

  {% if block.settings.text != blank %}
    <span class="icon-text-block__text">{{ block.settings.text }}</span>
  {% endif %}
</div>

{% stylesheet %}
  .icon-text-block {
    display: flex;
    align-items: center;
    gap: 0.5em;
    width: 100%;
  }

  .icon-text-block--align-left {
    justify-content: flex-start;
  }

  .icon-text-block--align-center {
    justify-content: center;
  }

  .icon-text-block--align-right {
    justify-content: flex-end;
  }

  .icon-text-block__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    flex-shrink: 0;
  }

  .icon-text-block__icon img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .icon-text-block__text {
    color: var(--icon-text-color);
    font-size: 0.85em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Icon with text",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Secure & encrypted checkout"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Icon with text",
      "category": "Custom"
    }
  ]
}
{% endschema %}
