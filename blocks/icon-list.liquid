

<div
  class="icon-list-block"
  style="--icon-list-label-color: {{ block.settings.label_color }};"
  {{ block.shopify_attributes }}
>
  {% for i in (1..4) %}
    {% liquid
      assign icon_key = 'icon_' | append: i
      assign label_key = 'label_' | append: i
      assign icon = block.settings[icon_key]
      assign label = block.settings[label_key]
    %}

    {% if icon != blank %}
      <div class="icon-list-block__item">
        <span class="icon-list-block__icon">
          {{ icon | image_url: width: 200 | image_tag: loading: 'lazy', widths: '50, 100, 150, 200' }}
        </span>
        {% if label != blank %}
          <span class="icon-list-block__label">{{ label }}</span>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>

{% stylesheet %}
  .icon-list-block {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25em;
  }

  .icon-list-block__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5em;
    max-width: 120px;
  }

  .icon-list-block__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
  }

  .icon-list-block__icon img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .icon-list-block__label {
    color: var(--icon-list-label-color);
    font-size: 0.8em;
    line-height: 1.3;
  }
{% endstylesheet %}

