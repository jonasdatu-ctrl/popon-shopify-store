<script>
  (function() {
    class NightGuardLaunch{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupOptionSelectors();
      }

      setupOptionSelectors() {
        const options = this.querySelectorAll('.ai-launch-option-{{ ai_gen_id }}');
        
        options.forEach(option => {
          option.addEventListener('click', function() {
            const optionType = this.getAttribute('data-option');
            const siblings = this.parentElement.querySelectorAll('.ai-launch-option-{{ ai_gen_id }}');
            
            siblings.forEach(sibling => sibling.classList.remove('active'));
            this.classList.add('active');
          });
        });
      }
    }

    customElements.define('night-guard-launch-{{ ai_gen_id }}', NightGuardLaunch{{ ai_gen_id }});
  })();
</script>

