  <section class="ai-launch-section-{{ ai_gen_id }} ai-launch-product-{{ ai_gen_id }}">
    <div class="ai-launch-container-{{ ai_gen_id }}">
      <div class="ai-launch-product-inner-{{ ai_gen_id }}">
        <div class="ai-launch-product-image-{{ ai_gen_id }}">
          {% if block.settings.product_image %}
            <img src="{{ block.settings.product_image | image_url: width: 800 }}" alt="{{ block.settings.product_image.alt | escape }}" loading="lazy">
          {% else %}
            <div style="background-color: #f4f4f4; width: 100%; aspect-ratio: 1; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
          
          <div class="ai-launch-callout-{{ ai_gen_id }} ai-launch-callout-1-{{ ai_gen_id }}">
            <div class="ai-launch-callout-dot-{{ ai_gen_id }}"></div>
            <div class="ai-launch-callout-text-{{ ai_gen_id }}">{{ block.settings.callout_1 }}</div>
          </div>
          
          <div class="ai-launch-callout-{{ ai_gen_id }} ai-launch-callout-2-{{ ai_gen_id }}">
            <div class="ai-launch-callout-dot-{{ ai_gen_id }}"></div>
            <div class="ai-launch-callout-text-{{ ai_gen_id }}">{{ block.settings.callout_2 }}</div>
          </div>
