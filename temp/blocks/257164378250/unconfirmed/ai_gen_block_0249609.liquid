      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading",
      "default": "Step 2"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Text",
      "default": "Describe the second step in your process"
    },
    {
      "type": "header",
      "content": "Step 3"
    },
