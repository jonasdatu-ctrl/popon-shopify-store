{% doc %}
  @prompt
    I need a section with 3 columns on desktop, each column has a image and text below it. In between the 3 sections there are arrows, they arrows are pointing right because this section is explaining the step by step, so it would be column 1, right arrow, column 2, right arrow, column 3. The arrows can be small, in between the columns. The mobile version will be in one column, and it will be: Image + Text arrow down Image + Text arrow down Image + Text , Can you give me full autonomy of the text so I can change fonts and everything
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-steps-container-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-steps-wrapper-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-steps-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-steps-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: {{ block.settings.text_alignment }};
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-steps-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-steps-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-steps-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-steps-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-steps-heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    text-transform: {{ block.settings.heading_text_transform }};
    line-height: {{ block.settings.heading_line_height }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
  }

  .ai-steps-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    line-height: {{ block.settings.text_line_height }};
    letter-spacing: {{ block.settings.text_letter_spacing }}px;
  }

  .ai-steps-arrow-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-steps-arrow-{{ ai_gen_id }} svg {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    stroke: {{ block.settings.arrow_color }};
    stroke-width: 2;
  }

  @media screen and (max-width: 749px) {
    .ai-steps-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-steps-arrow-{{ ai_gen_id }} {
      transform: rotate(90deg);
    }

    .ai-steps-image-wrapper-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-steps-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-steps-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }
  }
{% endstyle %}

<step-by-step-{{ ai_gen_id }}
  class="ai-steps-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-steps-wrapper-{{ ai_gen_id }}">
    <div class="ai-steps-grid-{{ ai_gen_id }}">
      <div class="ai-steps-column-{{ ai_gen_id }}">
        <div class="ai-steps-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image_1 %}
            <img
              src="{{ block.settings.image_1 | image_url: width: 800 }}"
              alt="{{ block.settings.image_1.alt | escape }}"
              class="ai-steps-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.image_1.width }}"
              height="{{ block.settings.image_1.height }}"
            >
          {% else %}
            <div class="ai-steps-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        {% if block.settings.heading_1 != blank %}
          <h3 class="ai-steps-heading-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h3>
        {% endif %}
        {% if block.settings.text_1 != blank %}
          <p class="ai-steps-text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</p>
        {% endif %}
      </div>

      <div class="ai-steps-arrow-{{ ai_gen_id }}">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </div>

      <div class="ai-steps-column-{{ ai_gen_id }}">
        <div class="ai-steps-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image_2 %}
            <img
              src="{{ block.settings.image_2 | image_url: width: 800 }}"
              alt="{{ block.settings.image_2.alt | escape }}"
              class="ai-steps-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.image_2.width }}"
              height="{{ block.settings.image_2.height }}"
            >
          {% else %}
            <div class="ai-steps-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        {% if block.settings.heading_2 != blank %}
          <h3 class="ai-steps-heading-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h3>
        {% endif %}
        {% if block.settings.text_2 != blank %}
          <p class="ai-steps-text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</p>
        {% endif %}
      </div>

      <div class="ai-steps-arrow-{{ ai_gen_id }}">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </div>

      <div class="ai-steps-column-{{ ai_gen_id }}">
        <div class="ai-steps-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image_3 %}
            <img
              src="{{ block.settings.image_3 | image_url: width: 800 }}"
              alt="{{ block.settings.image_3.alt | escape }}"
              class="ai-steps-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.image_3.width }}"
              height="{{ block.settings.image_3.height }}"
            >
          {% else %}
            <div class="ai-steps-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        {% if block.settings.heading_3 != blank %}
          <h3 class="ai-steps-heading-{{ ai_gen_id }}">{{ block.settings.heading_3 }}</h3>
        {% endif %}
        {% if block.settings.text_3 != blank %}
          <p class="ai-steps-text-{{ ai_gen_id }}">{{ block.settings.text_3 }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</step-by-step-{{ ai_gen_id }}>

<script>
  (function() {
    class StepByStep{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('step-by-step-{{ ai_gen_id }}', StepByStep{{ ai_gen_id }});
  })();
</script>

