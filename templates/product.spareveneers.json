            "page": "",
            "display_html_content": true,
            "image": "shopify://shop_images/30_day_G.svg",
            "text": "<p>Our 30-day \"Pop On Promise Warranty\" ensures you love your Pop On Veneers.</p>",
            "additional_content": "<ul><li>30-day warranty</li><li>Up to one remake included for the perfect fit</li><li>Dedicated support team every step of the way!</li></ul>",
