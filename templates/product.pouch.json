        "accordion_UXCBAr": {
          "type": "accordion",
          "settings": {
            "question": "What are Pop On Energy Pouches?",
            "answer": "<p>Pop On Energy Pouches are a <strong>nicotine-free</strong> way to enjoy clean energy and fresh breath in a discreet pouch. They are smoke-free, spit-free, and hands-free, making them easy to use anytime, anywhere.</p><p>Each pouch contains 50 mg of caffeine and Alpha GPC and L-Theanine for smooth focus in a discreet pouch placed under the upper lip on your gum line.</p><p>Pop On Energy Pouches are intended for 18+ adult use only.</p>",
            "liquid": ""
          }
        },
        "accordion_98iAkM": {
          "type": "accordion",
          "settings": {
            "question": "Who are Pop On Energy Pouches for?",
            "answer": "<p>Pop On Energy Pouches are designed for adults looking for a convenient, discreet energy boost and fresh breath experience.</p><p>They are ideal for people who want:</p><ul><li>A portable alternative to energy drinks</li><li>Fresh breath throughout the day</li><li>A hands-free energy option</li><li>A nicotine-free pouch experience</li></ul><p>If you are sensitive to caffeine or prefer to avoid caffeine, this product may not be for you.</p>",
            "liquid": ""
          }
        },
        "accordion_fk6tzk": {
          "type": "accordion",
          "settings": {
            "question": "Are Pop On Pouches nicotine-free?",
            "answer": "<p>Yes. Pop On Pouches contain <strong>zero nicotine and zero tobacco</strong>.</p>",
            "liquid": ""
          }
        },
        "accordion_XabanF": {
          "type": "accordion",
          "settings": {
            "question": "What are Pop On Pouches used for?",
            "answer": "<p>They are designed to provide <strong>clean energy, fresh breath, and a discreet, hands-free alternative to energy drinks or gum</strong>.</p>",
            "liquid": ""
          }
        },
        "accordion_eF38fR": {
          "type": "accordion",
          "settings": {
            "question": "How do Pop On Pouches work?",
            "answer": "<p>Place a pouch <strong>under your upper lip</strong>. The ingredients gradually release and are absorbed through the gums and oral lining.</p>",
            "liquid": ""
          }
        },
