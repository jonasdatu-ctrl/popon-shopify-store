        "liquid_dAGg7r": {
          "type": "liquid",
          "settings": {
            "liquid": "<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n  const triggers = document.querySelectorAll(\n    'a[href=\"#product-info-container\"], c-sticky-atc .inner-container div.c-button'\n  );\n\n  // Target the actual ATC button to simulate\n  const buyButton = document.querySelector('c-buy-button button.atc');\n\n  if (!buyButton) return;\n\n  triggers.forEach(function (el) {\n    el.addEventListener('click', function (e) {\n      // Stop default behavior and bubbling\n      e.preventDefault();\n      e.stopImmediatePropagation();\n\n      // Simulate click on the real ATC button\n      buyButton.click();\n    });\n  });\n});\n</script>"
          }
        }
      },
