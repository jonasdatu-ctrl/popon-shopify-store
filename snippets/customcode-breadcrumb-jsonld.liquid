{% comment %}
  Renders BreadcrumbList JSON-LD for a product page: Home > Collection (if resolvable) > Product.
  Collection tier resolution order: closest.collection (page reached via a collection-scoped
  route) > crumb_product's first associated collection > omitted (Home > Product only).
  Usage: {% render 'customcode-breadcrumb-jsonld', crumb_product: c_product %}
{% endcomment %}
{% liquid
  assign crumb_collection = closest.collection
  if crumb_collection == blank
    assign crumb_collection = crumb_product.collections.first
  endif
%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ request.origin | json }}
      }
      {%- if crumb_collection != blank -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ crumb_collection.title | json }},
          "item": {{ request.origin | append: crumb_collection.url | json }}
        }
        ,{
          "@type": "ListItem",
          "position": 3,
          "name": {{ crumb_product.title | json }},
          "item": {{ request.origin | append: crumb_product.url | json }}
        }
      {%- else -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ crumb_product.title | json }},
          "item": {{ request.origin | append: crumb_product.url | json }}
        }
      {%- endif -%}
    ]
  }
</script>
