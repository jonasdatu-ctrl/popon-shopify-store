{% comment %}
  YouTube Reviews Carousel shell.

  Accepts:
    - video_ids:  array of 11-char YouTube ids for page 1 (server-rendered)
    - quality:    YouTube thumbnail quality (e.g. hqdefault, mqdefault)
    - base_handle: page handle prefix used for lazy paging (e.g. video-reviews)
    - feed_view:  'true' | 'false' — whether to fetch with ?view=video-feed
    - heading:    optional section heading

  Behaviour (autoplay-on-click, infinite paging) lives in
  assets/customcode-youtube-carousel.js (<youtube-carousel-slider>).
{% endcomment %}

{% assign yt_quality = quality | default: 'hqdefault' %}
{% assign yt_base = base_handle | default: 'video-reviews' %}
{% assign yt_feed = feed_view | default: 'true' %}

<style>
  youtube-carousel-slider { display: block; position: relative; width: 100%; overflow: hidden; max-width: 1080px; margin: auto; }
  .ytc-section .ytc-heading { text-align: center; margin-bottom: 10px; color: #003659; font-weight: normal; }

  /* Carousel layout */
  youtube-carousel-slider .ytc-container { position: relative; display: flex; align-items: center; }
  youtube-carousel-slider .ytc-track {
    display: grid; grid-auto-flow: column; gap: 15px; overflow-x: auto;
    scroll-snap-type: x mandatory; scrollbar-width: none; width: 100%;
    grid-auto-columns: calc(100% / 1.1);
  }
  youtube-carousel-slider .ytc-track::-webkit-scrollbar { display: none; }

  @media (min-width: 750px) {
    youtube-carousel-slider .ytc-track { grid-auto-columns: calc((100% - 30px) / 2.2); }
  }

  /* Slide / facade (16:9 landscape) */
  youtube-carousel-slider .ytc-slide { scroll-snap-align: start; border-radius: 12px; overflow: hidden; cursor: pointer; position: relative; }
  youtube-carousel-slider .ytc-inner { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; }
  youtube-carousel-slider .ytc-thumb { width: 100%; height: 100%; object-fit: cover; display: block; }

  youtube-carousel-slider .ytc-overlay {
    position: absolute; inset: 0; background: rgba(0,0,0,0.2);
    display: flex; align-items: center; justify-content: center;
    transition: opacity 0.3s ease; z-index: 2;
  }
  youtube-carousel-slider .ytc-slide:hover .ytc-overlay { opacity: 0.6; }
  youtube-carousel-slider .ytc-play-btn {
    width: 56px; height: 56px; border-radius: 50%; background: rgba(0,0,0,0.35);
    display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px);
  }
  youtube-carousel-slider .ytc-play-btn svg { transform: scale(1.4); }

  /* The sentinel takes no visible space but is the last grid column. */
  youtube-carousel-slider .ytc-sentinel { width: 1px; }

  /* Horizontal nav arrows */
  youtube-carousel-slider .ytc-nav-arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid #fff;
    background: white; cursor: pointer; display: flex; align-items: center; justify-content: center;
    z-index: 10; color: black; box-shadow: gray 0px 0px 10px;
  }
  youtube-carousel-slider .ytc-nav-arrow.prev { left: 10px; transform: translateY(-50%) rotate(90deg); }
  youtube-carousel-slider .ytc-nav-arrow.next { right: 10px; transform: translateY(-50%) rotate(-90deg); }
  youtube-carousel-slider .ytc-nav-arrow.hidden { opacity: 0; pointer-events: none; }

  /* Modal (single landscape player) */
  youtube-carousel-slider .ytc-modal { position: fixed; inset: 0; z-index: 9999; display: none; background-color: rgba(0,0,0,0.6); backdrop-filter: blur(10px); }
  youtube-carousel-slider .ytc-modal[aria-hidden="false"] { display: block; }

  youtube-carousel-slider .ytc-modal-close {
    position: absolute; top: 10px; right: 10px; z-index: 10005;
    background: transparent; border: none; color: white;
    width: 44px; height: 44px; cursor: pointer; display: flex; align-items: center; justify-content: center;
    font-size: 40px; line-height: 1;
  }

  youtube-carousel-slider .ytc-modal-viewport { height: 100vh; width: 100vw; display: flex; align-items: center; justify-content: center; padding: 0 16px; box-sizing: border-box; }
  youtube-carousel-slider .ytc-modal-stage { width: min(90vw, calc(90vh * 16 / 9)); aspect-ratio: 16 / 9; }
  youtube-carousel-slider .ytc-modal-iframe { width: 100%; height: 100%; border: 0; border-radius: 8px; }

  youtube-carousel-slider .ytc-m-arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    background: rgba(0,0,0,0.35); border: none; border-radius: 50%;
    width: 52px; height: 52px; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 10005;
  }
  youtube-carousel-slider .ytc-m-arrow.prev { left: 12px; transform: translateY(-50%) rotate(90deg); }
  youtube-carousel-slider .ytc-m-arrow.next { right: 12px; transform: translateY(-50%) rotate(-90deg); }
  youtube-carousel-slider .ytc-m-arrow svg { width: 28px; fill: #fff; }
</style>

<section class="ytc-section">
  {% if heading != blank %}
    <h4 class="ytc-heading">{{ heading | escape }}</h4>
  {% endif %}

  <youtube-carousel-slider
    data-base-handle="{{ yt_base | escape }}"
    data-quality="{{ yt_quality | escape }}"
    data-feed-view="{{ yt_feed }}">
    <div class="ytc-container">
      <div class="ytc-track">
        {% for id in video_ids %}
          {% if id != blank %}
            <div class="ytc-slide" data-video-id="{{ id | escape }}" data-index="{{ forloop.index0 }}">
              <div class="ytc-inner">
                <img class="ytc-thumb" loading="lazy" width="480" height="360"
                     src="https://i.ytimg.com/vi/{{ id | escape }}/{{ yt_quality }}.jpg"
                     alt="Customer review video">
                <div class="ytc-overlay">
                  <div class="ytc-play-btn">
                    <svg viewBox="0 0 100 100" width="30" height="30"><polygon points="35,25 35,75 75,50" fill="white"/></svg>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
        <div class="ytc-sentinel" aria-hidden="true"></div>
      </div>

      <button class="ytc-nav-arrow prev" aria-label="Previous">
        <svg viewBox="0 0 10 6" width="18"><path fill-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"></path></svg>
      </button>
      <button class="ytc-nav-arrow next" aria-label="Next">
        <svg viewBox="0 0 10 6" width="18"><path fill-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"></path></svg>
      </button>
    </div>

    <div class="ytc-modal" aria-hidden="true">
      <button class="ytc-modal-close" aria-label="Close">✕</button>
      <button class="ytc-m-arrow prev" aria-label="Previous video">
        <svg viewBox="0 0 10 6"><path d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="white"></path></svg>
      </button>
      <button class="ytc-m-arrow next" aria-label="Next video">
        <svg viewBox="0 0 10 6"><path d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="white"></path></svg>
      </button>
      <div class="ytc-modal-viewport">
        <div class="ytc-modal-stage"><!-- single live iframe injected here --></div>
      </div>
    </div>
  </youtube-carousel-slider>
</section>
