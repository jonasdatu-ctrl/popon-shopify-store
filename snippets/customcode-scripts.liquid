  class CBuyBoxV2 extends HTMLElement {
    constructor() {
      super();
      const manifestEl = this.querySelector('#VariantManifest');
      this.variants = manifestEl ? JSON.parse(manifestEl.textContent) : [];
      this.defaultSelector = this.dataset.defaultSelector;
      this.currentVariant = null;
    }

    connectedCallback() {
      this.initListeners();
      this.updateState();
    }

    initListeners() {
      this.addEventListener('click', (e) => {
        const btn = e.target.closest('.value-button');
        if (btn) this.handleOptionClick(btn);
      });
      this.querySelector('#MainAddToCart').addEventListener('click', () => this.addToCart());
    }

    handleOptionClick(target) {
      const container = target.closest('.value-container');
      container.querySelectorAll('.value-button').forEach(btn => btn.removeAttribute('active'));
      target.setAttribute('active', '');
      this.updateState();
    }

    updateState() {
      const selectedOptions = {};
      this.querySelectorAll('.value-container').forEach(container => {
        const index = container.dataset.optionIndex;
        const activeBtn = container.querySelector('.value-button[active]');
        if (activeBtn) selectedOptions[index] = activeBtn.dataset.value;
      });

      this.currentVariant = this.variants.find(v => {
        return Object.keys(selectedOptions).every(key => v[key] === selectedOptions[key]);
      });

      if (this.currentVariant) {
        const allocations = this.currentVariant.selling_plan_allocations || [];

        const currentChoiceIsValid =
          this.selectedDeliveryId === 'otp' ||
          allocations.some(alloc => `sub-${alloc.selling_plan_id}` === this.selectedDeliveryId);

        if (!currentChoiceIsValid) {
          if (allocations.length > 0 && this.defaultSelector === 'subs') {
            this.selectedDeliveryId = `sub-${allocations[0].selling_plan_id}`;
          } else {
            // Force OTP when no subscriptions exist for this variant, or when the default is OTP
            this.selectedDeliveryId = 'otp';
          }
        }
      }

      this.renderDeliveryOptions();
      this.updateATCButton();
    }

    renderDeliveryOptions() {
      const container = this.querySelector('#DeliveryContainer .delivery-option-container');
      if (!this.currentVariant) {
        container.innerHTML = `<p>Selection unavailable</p>`;
        return;
      }

      const allocations = this.currentVariant.selling_plan_allocations || [];
      const hasSubs = allocations.length > 0;

      let selectedId = this.selectedDeliveryId;      

      const otpPriceRaw = this.currentVariant.price;
      const otpPriceFormatted = (otpPriceRaw / 100).toFixed(2);
      const comparePriceFormatted = this.currentVariant.compare_at_price 
        ? (this.currentVariant.compare_at_price / 100).toFixed(2) 
        : null;

      const isOtpSelected = selectedId === 'otp';
      const isSubSelected = selectedId.startsWith('sub-');

      // 1. Render OTP with conditional active class
      let html = `
        <div class="delivery-option ${isOtpSelected ? 'is-active' : ''}">
          <input type="radio" id="otp" name="delivery-option" value="" 
            ${isOtpSelected ? 'checked' : ''}>
          <label for="otp">
            <span>Buy Once</span>
            <span>
              <span class="price-display">$${otpPriceFormatted}</span>
              ${comparePriceFormatted ? `<span class="compare-price">$${comparePriceFormatted}</span>` : ''}
            </span>
          </label>
        </div>
      `;

      // 2. Render Subscription Group with conditional active class
      if (hasSubs) {
        html += `
          <div class="sub-group-container ${isSubSelected ? 'is-active' : ''}">
            <div class="sub-promo-banner">Biggest Savings</div>
            <div class="sub-options-inner">
        `;

        allocations.forEach(alloc => {
          const subPriceRaw = alloc.price;
          const subPriceFormatted = (subPriceRaw / 100).toFixed(2);
          const radioId = `sub-${alloc.selling_plan_id}`;
          const isThisSubSelected = selectedId === radioId;
          const savingsPercent = Math.round(((otpPriceRaw - subPriceRaw) / otpPriceRaw) * 100);
          
          html += `
            <div class="delivery-option sub-row">
              <input type="radio" id="${radioId}" name="delivery-option" value="${alloc.selling_plan_id}"
                ${isThisSubSelected ? 'checked' : ''}>
              <label for="${radioId}">
                <span>Subscribe and Save ${savingsPercent}%</span>
                <span>
                  <span class="price-display">$${subPriceFormatted}</span>
                  <span class="compare-price">$${otpPriceFormatted}</span>
                </span>
              </label>
            </div>
          `;
        });

        html += `
              <hr class="sub-divider">
              <ul class="sub-value-props">
        `;

        const featuresAttr = this.getAttribute('data-sub-features') || "";
        const features = featuresAttr.split('|').filter(f => f.trim() !== "");
        
        features.forEach(feature => {
          html += `<li>${feature.trim()}</li>`;
        });

        html += `
            </ul>
            </div>
          </div>
        `;
      }

      container.innerHTML = html;

      // Add listener to re-render when radio changes to update highlights
      container.querySelectorAll('input[name="delivery-option"]').forEach(input => {
        input.addEventListener('change', (e) => {
          this.selectedDeliveryId = e.target.id; // Update tracked ID
          this.renderDeliveryOptions(); // Re-render to update active classes
        });
      });
    }

    updateATCButton() {
      const btn = this.querySelector('#MainAddToCart');
      if (!this.currentVariant || !this.currentVariant.available) {
        btn.disabled = true;
        btn.textContent = 'SOLD OUT';
      } else {
        btn.disabled = false;
        btn.textContent = 'ADD TO CART';
      }
    }

    async addToCart() {
      const properties = {};
      const caseId = localStorage.getItem('previousVeneerOrder');      

      const btn = this.querySelector('#MainAddToCart');
      const selectedRadio = this.querySelector('input[name="delivery-option"]:checked');
      const sellingPlanId = selectedRadio ? selectedRadio.value : null;

      if (caseId) {
        properties['Shipping With Veneer Order'] = caseId;
      }      
      
      const body = {
        items: [{
          id: this.currentVariant.id,
          quantity: 1,
          ...(Object.keys(properties).length && { properties }),
          ...(sellingPlanId && { selling_plan: parseInt(sellingPlanId) })
        }]
      };

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'ADDING...';

      try {
        const response = await fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (!response.ok) throw new Error('Failed to add to cart');
        btn.textContent = 'ADDED!';
        document.dispatchEvent(new CustomEvent('cart:refresh'));
      } catch (err) {
        console.error(err);
        btn.textContent = 'ERROR';
      } finally {
        setTimeout(() => { this.updateATCButton(); }, 2000);
      }
    }
