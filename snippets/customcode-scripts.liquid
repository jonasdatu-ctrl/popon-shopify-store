<script>
  //Parameter based functions
  (function () {
    // 1. Extraction Logic
    const params = new URLSearchParams(window.location.search);
    const caseId = params.get('caseId');
    const orderEmail = params.get('orderEmail');
    const giftVariantId = params.get('variantgift');

    if (caseId) {
      localStorage.setItem('previousVeneerOrder', caseId);
    }
    
    if (orderEmail) {
      localStorage.setItem('previousOrderEmail', orderEmail);
    }

    // 2. DOM Population Logic
    document.addEventListener('DOMContentLoaded', function() {
      const emailField = document.querySelector('input[name="properties[Previous-Order-Email]"]');
      const storedEmail = localStorage.getItem('previousOrderEmail');

      if (emailField && storedEmail) {
        emailField.value = storedEmail;
      }
    });

    document.addEventListener('DOMContentLoaded', async () => {
      if (!giftVariantId) return;

      try {
        const cart = await fetch('/cart.js').then(r => r.json());

        const exists = cart.items.some(
          item => String(item.variant_id) === String(giftVariantId)
        );

        if (exists) return;

        await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            id: giftVariantId,
            quantity: 1
          })
        });

        console.log(`Gift variant ${giftVariantId} added to cart.`);
      } catch (err) {
        console.error('Failed to process gift variant:', err);
      }
    });  

  })();
</script>

