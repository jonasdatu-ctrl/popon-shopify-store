  class CMarqueeGenerator extends HTMLElement {
    constructor() {
      super();
      this.speed = 0.5; // px per frame – adjust as needed
    }

    connectedCallback() {
      this.track = this.querySelector('.c-content-marquee-track');
      if (!this.track) return;

      this.original = this.querySelector('.marquee-item-original');

      this.waitForImages().then(() => {
        this.setupClones();
        this.startAnimation();
      });
    }

    waitForImages() {
      const images = this.querySelectorAll('img');
      if (images.length === 0) return Promise.resolve();

      let loaded = 0;
      return new Promise((resolve) => {
        images.forEach((img) => {
          if (img.complete) {
            loaded++;
            if (loaded === images.length) resolve();
          } else {
            img.onload = img.onerror = () => {
              loaded++;
              if (loaded === images.length) resolve();
            };
          }
        });
      });
    }

    setupClones() {
      let totalWidth = this.original.offsetWidth;

      while (totalWidth < this.offsetWidth * 2) {
        const clone = this.original.cloneNode(true);
        clone.classList.remove('marquee-item-original');
        clone.classList.add('marquee-item-clone');
        this.track.appendChild(clone);
        totalWidth += clone.offsetWidth;
      }

      this.pos = 0;
    }

    startAnimation() {
      const step = () => {
        this.pos -= this.speed;

        const width = this.original.offsetWidth;
        if (Math.abs(this.pos) >= width) {
          this.pos += width;
        }

        this.track.style.transform = `translateX(${this.pos}px)`;
        requestAnimationFrame(step);
      };

      requestAnimationFrame(step);
    }
  }
  class CScarcity extends HTMLElement {
    constructor() {
      super();
      this.holidays = [
        '01-01',
        '01-20',
        '02-17',
        '05-26',
        '06-19',
        '07-04',
        '09-01',
        '10-13',
        '11-11',
        '11-27',
        '12-25',
      ];
    }
    connectedCallback() {
      this.processingDays = parseInt(this.dataset.processingDays);
      this.qtyLimit = parseInt(this.dataset.qtyLimit);
      this.qtySold = parseInt(this.dataset.qtySold);

      this.qtyLeft = this.qtyLimit - this.qtySold;
      this.output = this.querySelector('.scarcity-output');

      this.render();
      this.timer = setInterval(() => this.updateCountdown(), 1000);
    }
    render() {
      const nowEST = this.getESTDate();
      const hour = nowEST.getHours();
      const minute = nowEST.getMinutes();

      const beforeCutoff = hour < 16 || (hour === 16 && minute === 0);

      if (beforeCutoff) {
        this.renderPreCutoff(nowEST);
      } else {
        this.renderPostCutoff(nowEST);
      }
    }
    renderPreCutoff(nowEST) {
      const cutoff = new Date(nowEST);
      cutoff.setHours(16, 0, 0, 0);

      const diffMs = cutoff - nowEST;
      const diffSec = Math.max(0, Math.floor(diffMs / 1000));

      const hours = this.pad(Math.floor(diffSec / 3600));
      const minutes = this.pad(Math.floor((diffSec % 3600) / 60));
      const seconds = this.pad(diffSec % 60);

      const countdown = `${hours}:${minutes}:${seconds}`;

      // If first render → inject full template
      if (!this.output.querySelector('.countdown')) {
        const deliveryDate = this.addBusinessDays(nowEST, this.processingDays);
        const deliveryFormatted = this.formatDate(deliveryDate);

        const text = `
        <span class="countdown" style="color:#ED5C86"><strong>${countdown}</strong></span>
        for kit delivery by 
        <strong>${deliveryFormatted}</strong><span class="ig-test">&nbsp;& extra <span style="font-size:13px"><strong>$20 off</strong></span></span>
      `;

        this.output.querySelector('img').insertAdjacentHTML('beforebegin', text);
        return;
      }

      // If already rendered → update ONLY the number
      this.output.querySelector('.countdown strong').textContent = countdown;
    }
    renderPostCutoff(nowEST) {
      this.postRendered = true;
      const deliveryDate = this.addBusinessDays(nowEST, this.processingDays + 1);
      const deliveryFormatted = this.formatDate(deliveryDate);

      const text = `
        Only <strong>${this.qtyLeft}</strong>
        kits left to receive by <strong>${deliveryFormatted}</strong><span class="ig-test">&nbsp;& extra <span style="13px"><strong>$20 off</strong></span></span>
      `;

      this.output.querySelector('img').insertAdjacentHTML('beforebegin', text);
    }
    addBusinessDays(startDate, daysToAdd) {
      let date = new Date(startDate);
      let added = 0;

      while (added < daysToAdd) {
        date.setDate(date.getDate() + 1);

        const day = date.getDay();
        const mmdd = this.formatMMDD(date);

        if (day !== 0 && day !== 6 && !this.holidays.includes(mmdd)) {
          added++;
        }
      }

      return date;
    }
    getESTDate() {
      const now = new Date();
      const utc = now.getTime() + now.getTimezoneOffset() * 60000;
      const estOffset = -5;
      return new Date(utc + 3600000 * estOffset);
    }
    formatMMDD(date) {
      const mm = String(date.getMonth() + 1).padStart(2, '0');
      const dd = String(date.getDate()).padStart(2, '0');
      return `${mm}-${dd}`;
    }
    formatDate(date) {
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      const month = months[date.getMonth()];
      const day = date.getDate();
      return `${month} ${day}`;
    }
    updateCountdown() {
      const nowEST = this.getESTDate();
      const hour = nowEST.getHours();
      const minute = nowEST.getMinutes();
      const beforeCutoff = hour < 16 || (hour === 16 && minute === 0);

      if (beforeCutoff) {
        this.renderPreCutoff(nowEST);
        return;
      }

      // After cutoff → render once then stop timer
      if (!this.postRendered) {
        this.renderPostCutoff(nowEST);
        this.postRendered = true;
      }

      clearInterval(this.timer);
    }
    pad(num) {
      return String(num).padStart(2, '0');
    }
  }
