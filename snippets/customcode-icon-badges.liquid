{% style %}
  .cfp-icon-badges-row[data-block-id="{{ block.id }}"] {
    margin-bottom: {{ block.settings.m_margin_bottom }}px;
  }
  @media screen and (min-width: 769px) {
    .cfp-icon-badges-row[data-block-id="{{ block.id }}"] {
      margin-bottom: {{ block.settings.d_margin_bottom }}px;
    }
  }
{% endstyle %}

{% liquid
  assign badge_icons = block.settings.icon_urls | split: '|'
  assign badge_texts = block.settings.texts | split: '|'
  assign badge_count = badge_icons.size
  if badge_texts.size > badge_count
    assign badge_count = badge_texts.size
  endif
%}
{% if badge_count > 0 %}
  <div class="cfp-icon-badges-row" data-block-id="{{ block.id }}">
    <div class="cfp-icon-badges">
      {% for i in (1..badge_count) %}
        {% assign badge_icon = badge_icons[forloop.index0] | strip %}
        {% assign badge_text = badge_texts[forloop.index0] | strip %}
        {% if badge_icon != blank or badge_text != blank %}
          <div class="cfp-icon-badge">
            {% if badge_icon != blank %}
              <img class="cfp-icon-badge__icon" src="{{ badge_icon }}" alt="" loading="lazy" width="32" height="32">
            {% endif %}
            {% if badge_text != blank %}
              <span class="cfp-icon-badge__text">{{ badge_text }}</span>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}
